{
  "name": "socratus-desktop",
  "version": "1.0.0",
  "author": "King David Maha",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/King18923/socratus.git"
  },
  "description": "Socratus – premium desktop ebook reader",
  "type": "module",
  "main": "dist-electron/main.js",
  "private": true,
  "scripts": {
    "build:electron": "tsc -p tsconfig.json",
    "build:web": "cd ../artifacts/ebook-reader && pnpm build:desktop",
    "build": "pnpm build:web && pnpm build:electron && electron-builder",
    "build:win": "pnpm build:web && pnpm build:electron && electron-builder --win",
    "build:mac": "pnpm build:web && pnpm build:electron && electron-builder --mac",
    "build:linux": "pnpm build:web && pnpm build:electron && electron-builder --linux",
    "start": "electron ."
  },
  "devDependencies": {
    "electron": "^31.7.3",
    "electron-builder": "^25.1.8",
    "@types/node": "^22.15.21",
    "typescript": "^5.9.0"
  },
  "build": {
    "appId": "com.socratus.app",
    "productName": "Socratus",
    "copyright": "Copyright © 2026 Socratus",
    "directories": {
      "output": "dist",
      "buildResources": "build-resources"
    },
    "files": [
      "dist-electron/**/*",
      "package.json",
      "../artifacts/ebook-reader/dist/**/*"
    ],
    "extraResources": [
      {
        "from": "app",
        "to": "app"
      }
    ],
    "mac": {
      "category": "public.app-category.books",
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] }
      ],
      "icon": "build-resources/icon.icns"
    },
    "win": {
      "target": [
        { "target": "nsis",     "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "build-resources/icon.ico"
    },
    "linux": {
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb",      "arch": ["x64"] }
      ],
      "icon": "build-resources/icon.png",
      "category": "Office"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
